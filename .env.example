# Public URL of this server (claude.ai connector URL is $BASE_URL/mcp)
BASE_URL=https://brain.globostofo.net

# OIDC provider "brain" in the SSO (client type: confidential)
OIDC_CONFIG_URL=https://auth.globostofo.net/application/o/brain/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Only SSO account allowed to use the brain (checked on every call, on top of the SSO binding)
ALLOWED_USERNAME=brain

# Signs the tokens this server issues to claude.ai and encrypts its OAuth state.
# Generate with: openssl rand -base64 36
# Changing it logs claude.ai out (reconnect the connector).
JWT_SIGNING_KEY=

# Notes repository (the deploy key must have write access)
BRAIN_REPO=git@github.com:Globostofo/brain.git

# Author of the "sync: heracles <date>" commits
GIT_AUTHOR_NAME=Romain CLEMENT
GIT_AUTHOR_EMAIL=romain.clement2301@gmail.com
GIT_COMMITTER_NAME=Romain CLEMENT
GIT_COMMITTER_EMAIL=romain.clement2301@gmail.com
