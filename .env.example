# Public HTTPS URL of this server (the MCP endpoint is $BASE_URL/mcp)
BASE_URL=https://brain-mcp.example.com

# OIDC client registered for this server at your identity provider (confidential client,
# redirect URI $BASE_URL/auth/callback)
OIDC_CONFIG_URL=https://sso.example.com/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Only account allowed to use the notes (OIDC claim preferred_username, checked on every call)
ALLOWED_USERNAME=

# Signs the tokens this server issues to MCP clients and encrypts its OAuth state.
# Generate with: openssl rand -base64 36
# Changing it logs every client out.
JWT_SIGNING_KEY=

# Optional: comma-separated redirect URI patterns MCP clients may register (wildcards allowed).
# Empty: any client may register; access is still limited to ALLOWED_USERNAME.
ALLOWED_REDIRECT_URIS=

# Notes repository, cloned over SSH with ./deploy_key (a deploy key with write access)
BRAIN_REPO=git@github.com:<owner>/<notes-repo>.git

# Author of the "sync: <SYNC_HOST_LABEL> <date>" commits
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=
# Optional: name in the commit messages, to tell this server's commits from other machines'
SYNC_HOST_LABEL=brain-mcp

# Optional: time zone of the commit dates
TZ=UTC

# Optional: index note (e.g. _index.md). It can be neither deleted nor moved, and every tool
# description asks the model to read it first. Empty: no index.
INDEX_NOTE=

# Optional: your own conventions, appended to the server instructions (language, folder
# layout, where to record what…)
BRAIN_INSTRUCTIONS=
